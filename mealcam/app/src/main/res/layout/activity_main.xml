<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- The photo just taken, shown until V / X / leaving the app. -->
    <ImageView
        android:id="@+id/shot"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@android:color/black" android:scaleType="fitCenter"
        android:visibility="gone" android:contentDescription="last photo" />

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@android:color/white" android:visibility="gone" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent" android:layout_height="match_parent">

        <View
            android:id="@+id/shutter"
            android:layout_width="80dp" android:layout_height="80dp"
            android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="32dp"
            android:background="@drawable/shutter_bg" android:contentDescription="take photo" />

        <LinearLayout
            android:id="@+id/review"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="32dp"
            android:orientation="horizontal" android:visibility="gone">
            <TextView
                android:id="@+id/discard"
                android:layout_width="80dp" android:layout_height="80dp" android:layout_marginEnd="32dp"
                android:background="@drawable/round_bg" android:gravity="center"
                android:text="✕" android:textColor="#FFFF8A80" android:textSize="34sp" />
            <TextView
                android:id="@+id/keep"
                android:layout_width="80dp" android:layout_height="80dp"
                android:background="@drawable/round_bg" android:gravity="center"
                android:text="✓" android:textColor="#FFB9F6CA" android:textSize="38sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/water"
            android:layout_width="68dp" android:layout_height="68dp"
            android:layout_gravity="bottom|start" android:layout_margin="24dp"
            android:alpha="0.75" android:background="@drawable/round_bg" android:gravity="center"
            android:text="@string/water" android:textColor="@android:color/white" android:textSize="13sp" />

        <TextView
            android:id="@+id/note"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|end" android:layout_marginEnd="24dp" android:layout_marginBottom="104dp"
            android:maxWidth="200dp" android:maxLines="3" android:ellipsize="end"
            android:background="@drawable/note_bg" android:padding="8dp"
            android:textColor="@android:color/white" android:textSize="14sp" android:visibility="gone" />

        <TextView
            android:id="@+id/meal"
            android:layout_width="68dp" android:layout_height="68dp"
            android:layout_gravity="bottom|end" android:layout_margin="24dp"
            android:alpha="0.4" android:background="@drawable/round_bg" android:gravity="center"
            android:text="🍽" android:textSize="30sp" />
    </FrameLayout>
</FrameLayout>
